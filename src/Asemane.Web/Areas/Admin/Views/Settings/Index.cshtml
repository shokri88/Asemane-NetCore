@model SettingsForm
@{ ViewData["Title"] = "تنظیمات سایت"; ViewData["Description"] = "اطلاعات عمومی استودیو و صفحه اصلی انگلیسی"; }
<form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="card mb-4"><div class="card-header">اطلاعات استودیو</div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="Brand" class="form-label">نام استودیو</label><input asp-for="Brand" class="form-control" dir="ltr" type="text" maxlength="150"><span asp-validation-for="Brand" class="field-error"></span></div><div class="col-md-4"><label asp-for="Phone" class="form-label">شماره تماس (چند شماره با ; جدا شوند)</label><input asp-for="Phone" class="form-control" dir="ltr" type="text" maxlength="200"><span asp-validation-for="Phone" class="field-error"></span></div><div class="col-md-4"><label asp-for="Email" class="form-label">ایمیل</label><input asp-for="Email" class="form-control" dir="ltr" type="email" maxlength="150"><span asp-validation-for="Email" class="field-error"></span></div><div class="col-md-4"><label asp-for="PostalCode" class="form-label">کد پستی</label><input asp-for="PostalCode" class="form-control" dir="ltr" maxlength="30"><span asp-validation-for="PostalCode" class="field-error"></span></div><div class="col-12"><label asp-for="MapEmbedUrl" class="form-label">لینک نقشه Google Maps</label><input asp-for="MapEmbedUrl" class="form-control" dir="ltr" maxlength="2000" type="url"><span asp-validation-for="MapEmbedUrl" class="field-error"></span><div class="form-text">فقط آدرس src نقشه، نه کد iframe. خالی باشد: مختصات یا نقشه قالب اصلی نمایش داده می‌شود.</div></div><div class="col-md-4"><label asp-for="InstagramUrl" class="form-label">آدرس اینستاگرام</label><input asp-for="InstagramUrl" class="form-control" dir="ltr" type="url" maxlength="500"><span asp-validation-for="InstagramUrl" class="field-error"></span></div><div class="col-md-4"><label asp-for="Latitude" class="form-label">عرض جغرافیایی</label><input asp-for="Latitude" class="form-control" dir="ltr" type="number" step="any"><span asp-validation-for="Latitude" class="field-error"></span></div><div class="col-md-4"><label asp-for="Longitude" class="form-label">طول جغرافیایی</label><input asp-for="Longitude" class="form-control" dir="ltr" type="number" step="any"><span asp-validation-for="Longitude" class="field-error"></span></div><input asp-for="CompletedProjects" type="hidden"><input asp-for="YearsExperience" type="hidden"><input asp-for="TeamCount" type="hidden"><div class="col-12"><label asp-for="Address" class="form-label">آدرس انگلیسی</label><input asp-for="Address" class="form-control" dir="ltr" maxlength="500"></div></div></div></div><partial name="_AboutStatistics" model="Model" /><div class="card mb-4"><div class="card-header">صفحه اصلی و لوگو</div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="HomeTitle" class="form-label">عنوان سئو صفحه اصلی *</label><input asp-for="HomeTitle" class="form-control" dir="ltr" maxlength="70" required></div><div class="col-md-6"><label asp-for="HomeDescription" class="form-label">توضیحات متا صفحه اصلی</label><input asp-for="HomeDescription" class="form-control" dir="ltr" maxlength="170"></div><div class="col-md-6"><label asp-for="Logo" class="form-label">جایگزینی لوگو</label><input asp-for="Logo" type="file" class="form-control" accept="image/jpeg,image/png,image/webp"><span asp-validation-for="Logo" class="field-error"></span><p class="form-text">فایل روی سرور ذخیره می‌شود. برای لوگوی شفاف PNG یا WebP انتخاب کنید.</p></div><div class="col-md-6">@if (Model.LogoId.HasValue) { <img src="/media/@Model.LogoId" alt="لوگوی فعلی" class="settings-logo"> }</div></div></div><div class="card-footer"><button class="btn btn-primary">ذخیره تنظیمات</button></div></div></form>
