@model ContentList
@{ ViewData["Title"] = Display.Kind(Model.Kind); ViewData["Description"] = "محتوای انگلیسی · " + Display.Persian(Model.Total) + " رکورد"; }
@section Actions { <a class="btn btn-primary" asp-action="Edit" asp-route-kind="@Model.Kind">افزودن محتوا</a> }
<form method="get" class="card card-body mb-4"><input type="hidden" name="kind" value="@Model.Kind"><div class="row g-3 align-items-end"><div class="col-lg-5"><label for="q" class="form-label">جست‌وجوی عنوان</label><input id="q" name="q" value="@Model.Query" class="form-control" placeholder="عنوان محتوا…"></div><div class="col-lg-3"><label for="status" class="form-label">وضعیت</label><select id="status" name="status" class="form-select" asp-for="Status"><option value="">همه</option><option value="published">منتشرشده</option><option value="draft">پیش‌نویس</option></select></div><div class="col-lg-2"><label for="sort" class="form-label">مرتب‌سازی</label><select id="sort" name="sort" class="form-select" asp-for="Sort"><option value="updated">آخرین ویرایش</option><option value="title">عنوان</option><option value="order">ترتیب نمایش</option></select></div><div class="col-lg-2"><button class="btn btn-outline-primary w-100">اعمال</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>عنوان</th><th>وضعیت</th><th>ترتیب</th><th>ویرایش</th><th class="actions-col">عملیات</th></tr></thead><tbody>
@foreach (var item in Model.Items) { var t = item.Translations.First(x => x.Culture == "en");
<tr><td><strong dir="ltr" class="d-block text-start">@t.Title</strong><small dir="ltr" class="d-block text-secondary text-start">@t.Slug</small></td><td><span class="badge @(t.Published ? "text-bg-success" : "text-bg-secondary")">@(t.Published ? "منتشرشده" : "پیش‌نویس")</span></td><td>@Display.Persian(item.SortOrder)</td><td class="text-nowrap">@Display.Date(item.UpdatedAt)</td><td><div class="d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a><a class="btn btn-sm btn-outline-secondary" asp-controller="Media" asp-action="Index" asp-route-contentId="@item.Id">تصاویر</a>
@if (t.Published) { <a class="btn btn-sm btn-light" href="@Slugs.Path(item.Kind,"en",t.Slug)" target="_blank" rel="noopener">نمایش ↗</a> }
@if (!(item.Kind == ContentKind.Page && item.Key is "about" or "contact")) { <form method="post" asp-action="Delete" data-confirm="این محتوا از سایت حذف شود؟ تصاویر برای بازیابی باقی می‌مانند."><input type="hidden" name="id" value="@item.Id"><input type="hidden" name="version" value="@item.Version"><button class="btn btn-sm btn-outline-danger">حذف</button></form> }
</div></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty-state">محتوایی با این شرایط پیدا نشد.</td></tr> }
</tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center"><span>صفحه @Display.Persian(Model.Page) از @Display.Persian(Model.Pages)</span><nav aria-label="صفحه‌بندی"><div class="btn-group">
@if (Model.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-route-kind="@Model.Kind" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page-1)">قبلی</a> }
@if (Model.Page < Model.Pages) { <a class="btn btn-sm btn-outline-secondary" asp-route-kind="@Model.Kind" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page+1)">بعدی</a> }
</div></nav></div></div>
