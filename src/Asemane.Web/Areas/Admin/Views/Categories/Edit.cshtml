@model CategoryForm
@{ ViewData["Title"] = Model.Id == 0 ? "دسته‌بندی جدید" : "ویرایش دسته‌بندی"; }
<form method="post" class="card"><input asp-for="Id" type="hidden"><div class="card-body"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Name" class="form-label">عنوان انگلیسی *</label><input asp-for="Name" class="form-control" dir="ltr" maxlength="100" required></div><div class="col-md-4"><label asp-for="Slug" class="form-label">آدرس *</label><input asp-for="Slug" class="form-control" dir="ltr" maxlength="120" required></div><div class="col-md-4"><label asp-for="Kind" class="form-label">بخش</label><select asp-for="Kind" class="form-select"><option value="Project">پروژه‌ها</option><option value="Article">مقالات</option></select></div><div class="col-md-4"><label asp-for="SortOrder" class="form-label">ترتیب</label><input asp-for="SortOrder" class="form-control" type="number" min="0" max="99999"></div></div></div><div class="card-footer d-flex gap-2"><button class="btn btn-primary">ذخیره</button><a asp-action="Index" class="btn btn-light">انصراف</a></div></form>
