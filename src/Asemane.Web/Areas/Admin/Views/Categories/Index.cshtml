@model List<Category>
@{ ViewData["Title"] = "دسته‌بندی‌ها"; ViewData["Description"] = "دسته‌بندی مستقل پروژه‌ها و مقالات"; }
@section Actions { <a asp-action="Edit" class="btn btn-primary">دسته‌بندی جدید</a> }
<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>عنوان</th><th>بخش</th><th>ترتیب</th><th>عملیات</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td>@c.Translations.FirstOrDefault(x => x.Culture == "en")?.Name</td><td>@Display.Kind(c.Kind)</td><td>@Display.Persian(c.SortOrder)</td><td><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">ویرایش</a><form method="post" asp-action="Delete" data-confirm="دسته‌بندی حذف شود؟"><input type="hidden" name="id" value="@c.Id"><button class="btn btn-sm btn-outline-danger">حذف</button></form></div></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="4" class="empty-state">ابتدا یک دسته‌بندی بسازید.</td></tr> }
</tbody></table></div>
