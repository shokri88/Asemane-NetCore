@model ResetPasswordForm
@{ ViewData["Title"] = "تغییر رمز کاربر"; }
<form method="post" class="card"><input asp-for="Id" type="hidden"><div class="card-body"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row"><div class="col-md-6"><label asp-for="Password" class="form-label">رمز جدید *</label><input asp-for="Password" class="form-control" dir="ltr" required minlength="12" autocomplete="new-password"><p class="form-text">حداقل ۱۲ کاراکتر همراه حروف بزرگ، کوچک، عدد و علامت</p></div></div></div><div class="card-footer d-flex gap-2"><button class="btn btn-primary">تغییر رمز</button><a asp-action="Index" class="btn btn-light">انصراف</a></div></form>
