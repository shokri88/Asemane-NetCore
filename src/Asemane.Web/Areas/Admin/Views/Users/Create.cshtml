@model UserForm
@{ ViewData["Title"] = "کاربر جدید"; }
<form method="post" class="card"><div class="card-body"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3"><div class="col-md-4"><label asp-for="DisplayName" class="form-label">نام *</label><input asp-for="DisplayName" class="form-control" required maxlength="100"></div><div class="col-md-4"><label asp-for="Email" class="form-label">ایمیل *</label><input asp-for="Email" class="form-control" dir="ltr" required></div><div class="col-md-4"><label asp-for="Role" class="form-label">نقش</label><select asp-for="Role" class="form-select"><option value="Editor">ویرایشگر محتوا</option><option value="Admin">مدیر کامل</option></select></div><div class="col-md-4"><label asp-for="Password" class="form-label">رمز اولیه *</label><input asp-for="Password" class="form-control" dir="ltr" required minlength="12" autocomplete="new-password"><p class="form-text">حداقل ۱۲ کاراکتر، حروف بزرگ و کوچک، عدد و علامت</p></div></div></div><div class="card-footer d-flex gap-2"><button class="btn btn-primary">ساخت کاربر</button><a asp-action="Index" class="btn btn-light">انصراف</a></div></form>
