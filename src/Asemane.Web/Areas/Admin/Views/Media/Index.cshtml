@model ContentItem
@{ ViewData["Title"] = "تصاویر محتوا"; ViewData["Description"] = Model.Translations.First(x => x.Culture == "en").Title; }
@section Actions { <a class="btn btn-outline-secondary" asp-controller="Content" asp-action="Edit" asp-route-id="@Model.Id">بازگشت به ویرایش</a> }
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="card mb-4"><input type="hidden" name="contentId" value="@Model.Id"><div class="card-header">افزودن تصویر</div><div class="card-body"><div class="row g-3">@if (Model.Kind is ContentKind.Project or ContentKind.Team) { <div class="col-md-4"><label for="role" class="form-label">نوع تصویر</label><select id="role" name="role" class="form-select">@foreach (var role in MediaRoles.ForKind(Model.Kind)) { <option value="@((int)role)">@Display.ImageType(role)</option> }</select><div class="form-text">@(Model.Kind == ContentKind.Team ? "عضو تیم: یک مربع اصلی ۱:۱ و دو تصویر افقی ۱۶:۹؛ هر جایگاه یک تصویر." : "خانه: عمودی ۲:۳، فهرست: مربع ۱:۱، بنر/گالری: افقی ۱۶:۹ پیشنهاد می‌شود.") فایل بدون برش خودکار ذخیره می‌شود.</div></div> }<div class="col-md-4"><label for="file" class="form-label">تصویر *</label><input id="file" name="file" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" required><div class="form-text">JPEG، PNG یا WebP · حداکثر ۸ مگابایت</div></div><div class="col-md-4"><label for="alt" class="form-label">متن جایگزین انگلیسی *</label><input id="alt" name="alt" class="form-control" dir="ltr" required maxlength="250"><div class="form-text">توصیف کوتاه و واقعی از محتوای تصویر</div></div></div></div><div class="card-footer"><button class="btn btn-primary">بارگذاری تصویر</button></div></form>
<div class="row g-4">
@foreach (var image in Model.Images.OrderBy(x => x.SortOrder).ThenBy(x => x.Id)) { var text = image.Translations.FirstOrDefault(x => x.Culture == "en");
<div class="col-md-6 col-xl-4"><div class="card h-100"><img src="/media/@image.Id" class="media-preview" alt="@text?.Alt" loading="lazy"><form method="post" asp-action="Update" class="d-flex flex-column flex-grow-1"><input type="hidden" name="Id" value="@image.Id"><input type="hidden" name="ContentId" value="@Model.Id"><div class="card-body">@if (Model.Kind is ContentKind.Project or ContentKind.Team) { <label for="role-@image.Id" class="form-label">نوع تصویر</label><select id="role-@image.Id" name="Role" class="form-select mb-3">@foreach (var role in MediaRoles.ForKind(Model.Kind)) { <option value="@((int)role)" selected="@(role == image.Role)">@Display.ImageType(role)</option> }</select> }<label class="form-label" for="alt-@image.Id">متن جایگزین *</label><input id="alt-@image.Id" name="Alt" value="@text?.Alt" class="form-control mb-3" dir="ltr" required maxlength="250"><label for="caption-@image.Id" class="form-label">زیرنویس تصویر</label><input id="caption-@image.Id" name="Caption" value="@text?.Caption" class="form-control mb-3" dir="ltr" maxlength="300"><label for="order-@image.Id" class="form-label">ترتیب</label><input id="order-@image.Id" name="SortOrder" value="@image.SortOrder" class="form-control mb-3" type="number" min="0" max="99999"><div class="setting-box"><div class="form-check"><input id="cover-@image.Id" type="checkbox" name="IsCover" value="true" checked="@image.IsCover" class="form-check-input"><label for="cover-@image.Id" class="form-check-label">تصویر اصلی محتوا</label></div></div></div><div class="card-footer"><button class="btn btn-sm btn-outline-primary">ذخیره مشخصات</button></div></form><form method="post" asp-action="Delete" class="px-3 pb-3" data-confirm="این تصویر برای همیشه از سرور حذف شود؟"><input type="hidden" name="id" value="@image.Id"><input type="hidden" name="contentId" value="@Model.Id"><button class="btn btn-sm btn-outline-danger">حذف تصویر</button></form></div></div>
}
@if (Model.Images.Count == 0) { <div class="col-12"><div class="card empty-state">هنوز تصویری بارگذاری نشده است.</div></div> }
</div>
