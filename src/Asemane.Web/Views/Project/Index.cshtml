@model PublicList
@inject SiteService SiteService
@{ Layout = null; var culture = ViewData["Culture"] as string ?? "en"; var chrome = await SiteService.GetAsync(culture);  }
<!DOCTYPE html>
<html lang="@culture">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <partial name="_Seo" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no" />

    <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700"> -->
    <link rel="stylesheet" href="/template/css/swiper.min.css">
    <link rel="stylesheet" href="/template/css/slick.min.css">
    <link rel="stylesheet" href="/template/css/magnific-popup.css">
    <link rel="stylesheet" href="/template/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/template/css/et-line-font.css">
    <link rel="stylesheet" href="/template/css/before-after.min.css">
    <link rel="stylesheet" href="/template/css/bootstrap.min.css">
    <link rel="stylesheet" href="/template/css/unit-test.css">
    <link rel="stylesheet" href="/template/css/style.css?v=1">
    <link rel="stylesheet" href="/template/css/custome-03-03.css">


</head>

<body>
    <!--PRELOADER-->
    <div class="prague-loader">
        <div class="prague-loader-wrapper">
            <div class="prague-loader-bar">
                @chrome.Settings.Brand
            </div>
        </div>
    </div>
    <!--/PRELOADER-->


    <!--HEADER-->
    <partial name="_PublicHeader" model="culture" />
    <!-- END HEADER -->




    <!--MAIN BODY-->
<h1 class="sr-only">Projects</h1>
    <div class="container no-padd margin-lg-145t margin-lg-145b margin-sm-100t margin-sm-70b">
        <div class="row">

            <div class="prague-dropdown">
                <a href="#" data-toggle="dropdown" class="dropdown">Filters</a>
                <ul class="prague-dropdown-menu">
<li class="@(string.IsNullOrEmpty(Model.Category) ? "active" : "")" tabindex="0" role="link" data-filter="p_f_all" data-url="/@culture/projects"><i class="fa fa-square-o"></i>All Work</li>
@foreach (var category in Model.Categories) { <li class="@(Model.Category == category.Slug ? "active" : "")" data-filter="p_f_@category.CategoryId" data-url="/@culture/projects?category=@category.Slug" tabindex="0" role="link"><i class="fa fa-square-o"></i>@category.Name</li> }
</ul>
            </div>

            <div class="col-sm-12 no-padd">

                <div data-unique-key="d30797fabd788147235e48099dfaacc0" class="js-load-more" data-start-page="1"
                    data-max-page="@Model.Pages" data-next-link="/@culture/projects?page=@(Model.Page + 1)">
                    <div class="row prague_grid prague_count_col4 prague_gap_col15 js-load-more-block no-footer-content prague-load-wrapper"
                        data-columns="prague_count_col4" data-gap="prague_gap_col15">
@{ var itemIndex = 0; }
@foreach (var t in Model.Items) { var cover = SiteService.ProjectImage(t.ContentItem,ImageRole.ProjectCard);
<div
                            class="portfolio-item-wrapp portfolio-item-paralax js-filter-simple-block p_f_all p_f_@(t.ContentItem.CategoryId) @(itemIndex++ % 3 == 1 ? "column_paralax" : "") ">
                            <div class="portfolio-item">

                                <div class="project-grid-wrapper">

                                    <a class="project-grid-item-img-link" href="@Slugs.Path(t.Kind,culture,t.Slug)" target="_self">
                                        <div class="project-grid-item-img">
                                            @if (cover is not null) { <img src="/media/@cover.Id" class="s-img-switch wp-post-image" alt="@SiteService.Alt(cover,culture)" /> }
                                        </div>
                                    </a>

                                    <div class="project-grid-item-content">
                                        <h4 class="project-grid-item-title"><a href="@Slugs.Path(t.Kind,culture,t.Slug)"
                                                target="_self">@t.Title</a></h4>
                                        <div class="project-grid-item-category">@t.Location</div>
                                    </div>

                                </div>

                            </div>
                        </div>
}
</div>


                </div>

            </div>
        </div>
    </div>
    <partial name="_TemplatePagination" model="Model" />
<!--/MAIN BODY-->



    <script src="/template/js/jquery.js"></script>
    <script src="/template/js/vivus.min.js"></script>
    <script src="/template/js/hammer.min.js"></script>
    <script src="/template/js/foxlazy.min.js"></script>
    <script src="/template/js/jquery.magnific-popup.min.js"></script>
    <script src="/template/js/all.js"></script>
    <script src="/template/js/isotope.pkgd.min.js"></script>
<script src="/js/project-filters.js" defer></script>
</body>

</html>
