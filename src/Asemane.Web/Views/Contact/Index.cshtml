@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model PublicDetail
@inject SiteService SiteService
@{ Layout = null; var culture = ViewData["Culture"] as string ?? "en"; var chrome = await SiteService.GetAsync(culture); var mapUrl = ContactMap.GetUrl(chrome.Settings,Configuration); }
<!DOCTYPE html>
<html lang="@culture">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <partial name="_Seo" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no" />

    <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700"> -->
    <link rel="stylesheet" href="/template/css/swiper.min.css">
    <link rel="stylesheet" href="/template/css/slick.min.css">
    <link rel="stylesheet" href="/template/css/magnific-popup.css">
    <link rel="stylesheet" href="/template/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/template/css/et-line-font.css">
    <link rel="stylesheet" href="/template/css/before-after.min.css">
    <link rel="stylesheet" href="/template/css/bootstrap.min.css">
    <link rel="stylesheet" href="/template/css/unit-test.css">
    <link rel="stylesheet" href="/template/css/shop.min.css">
    <link rel="stylesheet" href="/template/css/style.css?v=1">

    <link rel="stylesheet" href="/template/css/custome-03-03.css">
</head>

<body>
    <!--PRELOADER-->
    <div class="prague-loader">
        <div class="prague-loader-wrapper">
            <div class="prague-loader-bar">
                @chrome.Settings.Brand
            </div>
        </div>
    </div>
    <!--/PRELOADER-->

    <!--HEADER-->
    <partial name="_PublicHeader" model="culture" />
    <!--/END HEADER-->
    <!--MAIN BODY-->
<h1 class="sr-only">@Model.Translation.Title</h1>

    <div class="container-fluid no-padd ">
        <div class="prodet-page contact-page ">
            <div class="row">
                <div class="container no-padd margin-top">
                    <div class="row-fluid">
                        <div class="col-sm-12 no-padd-inner">
                            <div class="project-detail-slider-outer map">
                                <iframe
                                    src="@mapUrl"
                                    width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"
                                    title="@Model.Translation.Title" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="container no-padd ">
                    <div class="row-fluid ">
                        <div class="col-sm-12 no-padd">
                            <div class="project-detail-block-outer">
                                <div class="project-detail-block-wrapper">
                                    <div class="project-detail-block-item">
                                        <div class="project-detail-block-title">
                                            <h6>
                                                Address :
                                            </h6>
                                        </div>
                                        <div class="project-detail-block-descr">
                                            <p>
                                                @chrome.Translation.Address
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="project-detail-block-wrapper mid">
                                    <div class="project-detail-block-item">
                                        <div class="project-detail-block-title">
                                            <h6> Phone Number : </h6>
                                        </div>
                                        <div class="project-detail-block-descr">
                                            <p class="call">
                                                @foreach (var phone in chrome.Settings.Phone.Split(new[] { ';', ',', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <a href="tel:@phone">@phone</a> }
                                            </p>
                                        </div>
                                    </div>
                                    <div class="project-detail-block-item">
                                        <div class="project-detail-block-title">
                                            <h6> Postal Code : </h6>
                                        </div>
                                        <div class="project-detail-block-descr">
                                            <p>
                                                @(chrome.Settings.PostalCode.Length > 0 ? chrome.Settings.PostalCode : Configuration["Site:PostalCode"])
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="project-detail-block-wrapper">
                                    <div class="project-detail-block-item">
                                        <div class="project-detail-block-title">
                                            <h6>
                                                Email :
                                            </h6>
                                        </div>
                                        <div class="project-detail-block-descr">
                                            <p>
                                                @chrome.Settings.Email
                                            </p>
                                        </div>
                                    </div>
                                    <div class="project-detail-block-item">
                                        <div class="project-detail-block-title">
                                            <h6>
                                                Social networks :
                                            </h6>
                                        </div>
                                        <div class="project-detail-block-descr">
                                            <p>
                                                @chrome.Settings.InstagramUrl
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--/MAIN BODY-->


    <script src="/template/js/jquery.js"></script>
    <script src="/template/js/slick.min.js"></script>
    <script src="/template/js/swiper-bundle.min.js"></script>
    <script src="/template/js/hammer.min.js"></script>
    <script src="/template/js/foxlazy.min.js"></script>
    <script src="/template/js/jquery.magnific-popup.min.js"></script>
    <script src="/template/js/all.js"></script>

</body>

</html>
