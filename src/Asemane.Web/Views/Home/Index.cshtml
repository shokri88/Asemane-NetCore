@model List<ContentTranslation>
@inject SiteService SiteService
@using Microsoft.EntityFrameworkCore
@{ Layout = null; var culture = ViewData["Culture"] as string ?? "en"; var chrome = await SiteService.GetAsync(culture);  }
<!DOCTYPE html>
<html lang="@culture">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <partial name="_Seo" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no" />

    <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700"> -->
    <link rel="stylesheet" href="/template/css/swiper.min.css">
    <link rel="stylesheet" href="/template/css/slick.min.css">
    <link rel="stylesheet" href="/template/css/magnific-popup.css">
    <link rel="stylesheet" href="/template/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/template/css/et-line-font.css">
    <link rel="stylesheet" href="/template/css/before-after.min.css">
    <link rel="stylesheet" href="/template/css/bootstrap.min.css">
    <link rel="stylesheet" href="/template/css/unit-test.css">
    <link rel="stylesheet" href="/template/css/style.css?v=1">
    <link rel="stylesheet" href="/template/css/custome-03-03.css">
</head>

<body>
    <!--PRELOADER-->
    <div class="prague-loader">
        <div class="prague-loader-wrapper">
            <div class="prague-loader-bar">
                @chrome.Settings.Brand
            </div>
        </div>
    </div>
    <!--/PRELOADER-->

    <!--HEADER-->
    <partial name="_PublicHeader" model="culture" />
    <!--/END HEADER-->

    <!--MAIN BODY-->
<h1 class="sr-only">@chrome.Translation.HomeTitle</h1>
    <div class="container-fluid no-padd margin-top home-page">
        <div class="row-fluid no-padd">
            <div class="col-sm-12 no-padd ">
                <div class="portfolio-slider-wrap full_showcase_slider showcase_slider ">
                    <div class="swiper-container" data-mouse="0" data-space="0" data-pagination-type="bullets"
                        data-mode="horizontal" data-autoplay="5000" data-loop="2" data-speed="1500" data-center="0"
                        data-responsive="responsive" data-slides-per-view="4" data-xs-slides="1,0" data-sm-slides="2,0"
                        data-md-slides="3,0" data-lg-slides="4,0">

                        <div class="swiper-wrapper">
@foreach (var t in Model) {
    var cover = SiteService.ProjectImage(t.ContentItem,ImageRole.HomeFirst);
    var second = SiteService.ProjectImage(t.ContentItem,ImageRole.HomeSecond);
    var category = t.ContentItem.Category?.Translations.FirstOrDefault(x => x.Culture == culture);
<div class="swiper-slide">
                                <div class="slide-image full-height-window-hard">
                                    @if (cover is not null) { <span class="images-slider-wrapper"><img src="/media/@cover.Id" alt="@SiteService.Alt(cover,culture)" class="s-img-switch"></span> }
                                    @if (second is not null) { <span class="images-slider-wrapper sec"><img src="/media/@second.Id" alt="@SiteService.Alt(second,culture)" class="s-img-switch"></span> }

                                </div>

                                <div class="content-showcase-wrapper ">
                                    <div class="slide-title"><a href="@Slugs.Path(t.Kind,culture,t.Slug)" target="_self">@t.Title</a></div>
                                    <div class="slide-category">@if (category is not null) { <a href="/@culture/projects?category=@category.Slug" rel="tag">@category.Name</a> }</div>
                                </div>
                            </div>
}
</div>
                        <div class="swiper-button-prev swiper-buttons"></div>
                        <div class="swiper-button-next swiper-buttons"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--/MAIN BODY-->




    <script src="/template/js/jquery.js"></script>
    <script src="/template/js/swiper.min.js"></script>
    <script src="/template/js/isotope.pkgd.min.js"></script>
    <script src="/template/js/tweenMax.min.js"></script>
    <script src="/template/js/vivus.min.js"></script>
    <script src="/template/js/slick.min.js"></script>
    <script src="/template/js/jquery.magnific-popup.min.js"></script>
    <script src="/template/js/hammer.min.js"></script>
    <script src="/template/js/foxlazy.min.js"></script>
    <script src="/template/js/all.js"></script>
    <script src="/template/js/kenburn.js"></script>
    <script src="/template/js/jquery.multiscroll.js"></script>
    <script src="/template/js/countTo.js"></script>
    <script src="/template/js/skills.js"></script>
    <script src="/template/js/split-slider.js"></script>
    <script src="/template/js/banner_slider.js"></script>
</body>

</html>
