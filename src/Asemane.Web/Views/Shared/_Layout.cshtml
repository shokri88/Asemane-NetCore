@inject SiteService SiteService
@using Microsoft.EntityFrameworkCore
@{ var culture = ViewData["Culture"] as string ?? "en"; var chrome = await SiteService.GetAsync(culture);  }
<!DOCTYPE html>
<html lang="@culture">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <partial name="_Seo" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no" />

    <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700"> -->
    <link rel="stylesheet" href="/template/css/swiper.min.css">
    <link rel="stylesheet" href="/template/css/slick.min.css">
    <link rel="stylesheet" href="/template/css/magnific-popup.css">
    <link rel="stylesheet" href="/template/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/template/css/et-line-font.css">
    <link rel="stylesheet" href="/template/css/before-after.min.css">
    <link rel="stylesheet" href="/template/css/bootstrap.min.css">
    <link rel="stylesheet" href="/template/css/unit-test.css">
    <link rel="stylesheet" href="/template/css/style.css?v=1">
    <link rel="stylesheet" href="/template/css/custome-03-03.css">
</head>

<body>
    <!--PRELOADER-->
    <div class="prague-loader">
        <div class="prague-loader-wrapper">
            <div class="prague-loader-bar">
                @chrome.Settings.Brand
            </div>
        </div>
    </div>
    <!--/PRELOADER-->

    <!--HEADER-->
    <partial name="_PublicHeader" model="culture" />
    <!--/END HEADER-->

@RenderBody()




    <script src="/template/js/jquery.js"></script>
    <script src="/template/js/swiper.min.js"></script>
    <script src="/template/js/isotope.pkgd.min.js"></script>
    <script src="/template/js/tweenMax.min.js"></script>
    <script src="/template/js/vivus.min.js"></script>
    <script src="/template/js/slick.min.js"></script>
    <script src="/template/js/jquery.magnific-popup.min.js"></script>
    <script src="/template/js/hammer.min.js"></script>
    <script src="/template/js/foxlazy.min.js"></script>
    <script src="/template/js/all.js"></script>
    <script src="/template/js/kenburn.js"></script>
    <script src="/template/js/jquery.multiscroll.js"></script>
    <script src="/template/js/countTo.js"></script>
    <script src="/template/js/skills.js"></script>
    <script src="/template/js/split-slider.js"></script>
    <script src="/template/js/banner_slider.js"></script>
</body>

</html>
